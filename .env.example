# Compose
COMPOSE_PROJECT_NAME=mrag-dify
TZ=Asia/Tokyo

# Dify 1.16.0: PostgreSQL + Qdrant
DB_TYPE=postgresql
VECTOR_STORE=qdrant
COMPOSE_PROFILES=qdrant,postgresql,collaboration
EXPOSE_NGINX_PORT=80
EXPOSE_NGINX_SSL_PORT=443
NGINX_HTTPS_ENABLED=false
SSRF_PROXY_ALLOW_PRIVATE_DOMAINS=mrag-api

# Replace these values by running ./scripts/init-env.sh.
DB_PASSWORD=CHANGE_ME
REDIS_PASSWORD=CHANGE_ME
QDRANT_API_KEY=CHANGE_ME
SECRET_KEY=CHANGE_ME
PLUGIN_DAEMON_KEY=CHANGE_ME
PLUGIN_DIFY_INNER_API_KEY=CHANGE_ME
DIFY_AGENT_SERVER_SECRET_KEY=CHANGE_ME

# mrag
MRAG_PROJECT_NAME=main-kb
MRAG_KNOWLEDGE_ID=main_kb
MRAG_API_KEY=CHANGE_ME
MRAG_OLLAMA_URL=http://ollama:11434
MRAG_EMBEDDING_MODEL=bge-m3:latest
MRAG_EMBEDDING_MODEL_MANIFEST_SHA256=7907646426070047a77226ac3e684fbbe8410524f7b4a74d02837e43f2146bab
MRAG_QDRANT_HOST=mrag-qdrant
MRAG_QDRANT_PORT=6333
MRAG_EXPOSE_PORT=8000
MRAG_RERANK_ENABLED=true
MRAG_RERANK_MODEL=hotchpotch/japanese-reranker-cross-encoder-small-v1
MRAG_RERANK_REVISION=d7462bce0b065e0624028b412693dec055d719a0
MRAG_RERANK_MAX_LENGTH=512
MRAG_RERANK_TOP_N=30
# true prevents all model downloads and requires the pinned models to exist.
MODEL_DOWNLOAD_OFFLINE=false

# Ollama container
# cpu: portable fallback and macOS development
# nvidia: Windows/WSL2 or Linux/AWS with NVIDIA Container Toolkit
OLLAMA_ACCELERATOR=cpu
OLLAMA_KEEP_ALIVE=10m

# Docling conversion
# Existing installations can add these settings without changing current
# secrets or custom values by running ./scripts/upgrade-env.sh.
DOCLING_ACCELERATOR=cpu
DOCLING_SERVE_URL=http://docling-serve:5001
DOCLING_SERVE_API_KEY=CHANGE_ME
DOCLING_CPUS=8.0
DOCLING_MEMORY_LIMIT=12g
DOCLING_WORKERS=1
DOCLING_SUPPORTED_EXTENSIONS=.pdf,.md,.txt,.docx,.xlsx,.pptx,.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp
DOCLING_OUTPUT_FORMAT=md
DOCLING_IMAGE_EXPORT_MODE=placeholder
DOCLING_OCR_ENABLED=true
DOCLING_OCR_LANGUAGES=ja,en
DOCLING_OCR_PRESET=
DOCLING_TABLE_MODE=accurate
DOCLING_PIPELINE=
DOCLING_PDF_BACKEND=
DOCLING_MAX_FILE_SIZE=
# Documents over this page count are NOT truncated: they are recorded as a
# conversion failure and left out of the index, because a silently half-ingested
# document answers questions with content it never read. Empty means no limit.
DOCLING_MAX_NUM_PAGES=
DOCLING_MAX_OUTPUT_SIZE=
DOCLING_CONNECTION_TIMEOUT_SECONDS=30
DOCLING_CONVERSION_TIMEOUT_SECONDS=1800
# Budget for the whole conversion phase. Once it is spent no further document is
# started; those left keep their existing Markdown and are retried by the next
# run, so a large backlog cannot make one sync overrun its cron interval. Empty
# means no budget, which is what a first-time or manual full conversion wants.
DOCLING_RUN_TIMEOUT_SECONDS=
DOCLING_POLL_INTERVAL_SECONDS=2
DOCLING_MAX_RETRIES=3
# Documents converted at once. docling-serve does the work, so raise this only
# together with its own worker count, and re-measure RAM (and VRAM on GPU).
DOCLING_BATCH_CONCURRENCY=1

# Scheduled sync
MRAG_CRON_SCHEDULE=0 */3 * * *
MRAG_DELETE_MAX_PERCENT=20
MRAG_DELETE_MAX_COUNT=50
MRAG_BACKUP_RETENTION=7
